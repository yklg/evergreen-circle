# 常青圈 EvergreenCircle Worker 环境变量模板
# 用法：复制到同目录 .env 并填真实值（deploy/.env 已被 .gitignore 忽略，不会入库）
#   cp deploy/.env.worker.example deploy/.env
#
# 命名约定：新名 LLM_*（厂商无关的 OpenAI 兼容连接）；旧名 ZHIPU_* 仍被兼容读取
# （backend/app/core/config.py 的 _legacy 兜底），迁移期二者皆可。

# ===== LLM（智谱 GLM / BigModel，OpenAI 兼容）=====
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-5.1
LLM_MODEL_CORE=glm-5.2
LLM_MODEL_AUX=glm-5.1
LLM_MODEL_FAST=glm-z1-air
LLM_TIMEOUT=180
LLM_MAX_RETRIES=1

# ===== 搜索（博查 Bocha Web Search）=====
BOCHA_API_KEY=sk-your_bocha_key_here
BOCHA_BASE_URL=https://api.bocha.cn/v1

# ===== 平台采集 Cookie（可选）=====
DOUYIN_COOKIE=
XHS_COOKIE=
BILIBILI_COOKIE=

# ===== 服务 / 持久化 =====
# 容器内必须监听 0.0.0.0（config.py 默认 127.0.0.1 仅适合本机单用户）
APP_HOST=0.0.0.0
APP_PORT=8000
# SQLite 落持久卷：compose 挂 /data；PaaS 挂 /data。不挂则重启丢全部任务/报告。
VERDA_DB_PATH=/data/verda.db
ENABLE_DEMO_FALLBACK=true
