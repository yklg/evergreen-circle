# ===== LLM 连接（OpenAI 兼容，厂商无关）=====
# 也可在「模型配置」页选择服务商（自动填入官方端点），或在此直接填写。
# 必填：对应厂商平台（智谱/DeepSeek/Kimi/通义…）申请的 API Key
LLM_API_KEY=your_api_key_here

# 默认模型；核心/辅助/杂务矩阵未在 .env 设置时用 config.py 内建默认（glm-5.2/5.1/z1-air）
LLM_MODEL=glm-5.1
# OpenAI 兼容网关地址（默认智谱 BigModel）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 注：旧名 ZHIPU_API_KEY / ZHIPU_MODEL / ZHIPU_BASE_URL 仍兼容（自动兜底读取），
# 新部署请使用上方 LLM_* 新名。

# ===== 搜索 API（采集 Agent 用）=====
# 博查 Bocha Web Search（必填，从 https://open.bocha.cn 获取，形如 sk-xxxxxx）
BOCHA_API_KEY=sk-xxxxxx
# 博查接口网关（一般无需改）
BOCHA_BASE_URL=https://api.bocha.cn/v1

# ===== 自媒体平台采集器 cookie/token（可选，第 17 章）=====
DOUYIN_COOKIE=
BILIBILI_COOKIE=
XHS_COOKIE=

# ===== 服务配置 =====
# 安全提醒：本项目接口无鉴权。APP_HOST 务必保持 127.0.0.1（仅本机可访问），
# 切勿改为 0.0.0.0 或暴露到公网 —— 否则同网/公网任何人都能读取并覆盖你的密钥。
# 确需远程访问时，请自行加防火墙或口令门禁。
APP_HOST=127.0.0.1
APP_PORT=8010
# 前端地址（CORS 白名单）
FRONTEND_ORIGIN=http://localhost:3400
# 无 key 时是否启用 demo 缓存兜底（演示不崩）
ENABLE_DEMO_FALLBACK=true

# ===== 百度地图开放平台（生活圈体检 · living_circle 域）=====
# 控制台：https://lbsyun.baidu.com/ → 应用管理 → 创建/查看「浏览器端」与「服务端」应用
# 建议两个应用分开建（服务端应用不用配 Referer 白名单；浏览器端必须配）：
#   - 服务端应用：启用「Geocoding/逆地理编码、地点检索、路线规划、坐标转换、批量算路」等 Web 服务 API → BAIDU_SERVER_AK
#   - 浏览器端应用：启用「JS API、地点搜索、地理编码」等 JS 服务，Referer 白名单按开发/线上域名填写 → BAIDU_BROWSER_AK
# 注意：AK 绑定域名后才会生效；开发环境 Referer 白名单示例：http://localhost:3400/*、http://127.0.0.1:3400/*
# 缺失 AK 时体检任务自动降级为内置 fixture 演示数据（不抛错，界面横幅标注 data_origin）。
BAIDU_SERVER_AK=
BAIDU_BROWSER_AK=
# 个性化地图 styleId（可选，C7 底图风格调适）：
# 百度控制台「特色服务平台 → 个性化地图」创建/发布样式后复制 Style ID 填入；
# 为空时前端回退内置 S2 低饱和浅色 styleJson 模板（与项目浅色视觉一致）。
BAIDU_MAP_STYLE_ID=
