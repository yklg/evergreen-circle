# ─────────────────────────────────────────────────────────────────────────────
# 本地开发双进程端口 · 单一真值源（dev-port-sync）
#
# start.sh / restart.sh / stop.sh 统一 source 本文件；vite.config.ts 的回落
# 默认值与其保持一致。**不要在任何脚本/配置里再写死端口号**，改端口只改这里，
# 三脚本与浏览器入口（http://localhost:FRONTEND_PORT）自动同步。
#
# 允许调用方环境变量覆盖：BACKEND_PORT=9000 ./start.sh
# 真值：后端 8010（仅 127.0.0.1）、前端 Vite 3400（/api 代理到后端）。
# 注：docker-compose 的容器/宿主映射固定 8010/3400，不走本文件。
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_PORT="${BACKEND_PORT:-8010}"
FRONTEND_PORT="${FRONTEND_PORT:-3400}"
export BACKEND_PORT FRONTEND_PORT
